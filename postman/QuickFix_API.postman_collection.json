{
  "info": {
    "name": "QuickFix API - Local Service Platform",
    "description": "Experiment 7: Validating RESTful APIs using Postman.\n\nThis collection covers all QuickFix API endpoints with test scripts for validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "requestId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints (Experiment 6)",
      "item": [
        {
          "name": "Register - Client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"customer@test.com\",\n  \"password\": \"password123\",\n  \"role\": \"client\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response contains success message', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.message).to.exist;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - Worker",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Worker\",\n  \"email\": \"worker@test.com\",\n  \"password\": \"password123\",\n  \"role\": \"worker\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - Validation Error (no email)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad User\",\n  \"password\": \"short\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 422 validation error', () => {",
                  "  pm.response.to.have.status(422);",
                  "  pm.expect(pm.response.json().errors).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has token', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.token).to.be.a('string');",
                  "  pm.collectionVariables.set('token', json.token);",
                  "});",
                  "pm.test('Response has user object', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.user).to.have.property('name');",
                  "  pm.expect(json.user).to.have.property('role');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Invalid Credentials",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"wrong@test.com\",\n  \"password\": \"wrongpass\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 400 for invalid credentials', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().message).to.include('Invalid');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Service Requests",
      "description": "CRUD operations for service requests (Experiments 4, 5)",
      "item": [
        {
          "name": "Create Service Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service\": \"Plumbing Works\",\n  \"location\": \"Bandra West, Mumbai\",\n  \"date\": \"2026-11-01\",\n  \"desc\": \"Leaking kitchen faucet needs repair\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/requests", "host": ["{{baseUrl}}"], "path": ["api", "requests"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Response contains service request data', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.service).to.equal('Plumbing Works');",
                  "  pm.expect(json.status).to.equal('Pending');",
                  "  pm.collectionVariables.set('requestId', json.id || json._id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Requests",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/requests", "host": ["{{baseUrl}}"], "path": ["api", "requests"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is an array', () => {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Requests - No Auth (should fail)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/requests", "host": ["{{baseUrl}}"], "path": ["api", "requests"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 without token', () => {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Request Status (Worker Accepts)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"In Progress\",\n  \"provider\": \"Test Worker\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/requests/{{requestId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "requests", "{{requestId}}", "status"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status updated to In Progress', () => {",
                  "  pm.expect(pm.response.json().status).to.equal('In Progress');",
                  "});",
                  "pm.test('Provider assigned', () => {",
                  "  pm.expect(pm.response.json().provider).to.equal('Test Worker');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Request Status (Complete)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Completed\",\n  \"provider\": \"Test Worker\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/requests/{{requestId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "requests", "{{requestId}}", "status"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status updated to Completed', () => {",
                  "  pm.expect(pm.response.json().status).to.equal('Completed');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Request",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/requests/{{requestId}}", "host": ["{{baseUrl}}"], "path": ["api", "requests", "{{requestId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns success message', () => {",
                  "  pm.expect(pm.response.json().message).to.include('deleted');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Request - Validation Error",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": { "raw": "{{baseUrl}}/api/requests", "host": ["{{baseUrl}}"], "path": ["api", "requests"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 422 for missing fields', () => {",
                  "  pm.response.to.have.status(422);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Rate Limit Test (send 101 requests)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/requests", "host": ["{{baseUrl}}"], "path": ["api", "requests"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// This tests that rate limiting headers exist",
                  "pm.test('Rate limit headers present', () => {",
                  "  pm.expect(pm.response.headers.has('RateLimit-Limit')).to.be.true;",
                  "  pm.expect(pm.response.headers.has('RateLimit-Remaining')).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
